# Base URL of the FastAPI backend. Defaults to http://localhost:8000 when unset.
VITE_API_BASE_URL=http://localhost:8000

# AI Companion: "backend" calls POST /api/assistant/chat (contract assistant-1, local Ollama).
# Anything else (or unset) keeps the companion visibly "not connected"; no answers are simulated.
# VITE_ASSISTANT_API=backend
